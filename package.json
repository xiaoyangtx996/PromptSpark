{
  "name": "promptspark",
  "version": "1.3.2",
  "private": true,
  "description": "PromptSpark — Cursor Composer prompt optimizer (Windows). Codex users: use Codex++.",
  "type": "module",
  "bin": {
    "promptspark": "./install.mjs",
    "prompt-optimize": "./install.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "proxy": "node proxy.mjs",
    "ensure-proxy": "node ensure-proxy.mjs",
    "codex-runtime": "node codex-runtime.mjs",
    "cursor-runtime": "node cursor-runtime.mjs",
    "install:hosts": "node install.mjs",
    "uninstall": "node install.mjs --uninstall"
  }
}
