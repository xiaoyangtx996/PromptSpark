{
  "name": "promptspark",
  "version": "1.4.12",
  "private": true,
  "description": "PromptSpark — Cursor Composer prompt optimizer (Windows). Codex users: use Codex++.",
  "type": "module",
  "bin": {
    "promptspark": "./install.mjs",
    "prompt-optimize": "./install.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "verify": "node build.mjs && node --check dist/prompt-optimize.js && node scripts/verify-build.mjs",
    "pack:vsix": "node scripts/pack-vsix.mjs",
    "release": "node scripts/release.mjs",
    "publish:marketplace": "node scripts/publish-marketplace.mjs",
    "shots:readme": "node scripts/capture-readme-shots.mjs",
    "proxy": "node runtime/proxy.mjs",
    "ensure-proxy": "node runtime/ensure-proxy.mjs",
    "cursor-runtime": "node runtime/cursor-runtime.mjs",
    "install:hosts": "node install.mjs",
    "uninstall": "node install.mjs --uninstall"
  }
}
